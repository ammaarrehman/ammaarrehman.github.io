{
  "name": "ammaarrehman-site-tools",
  "private": true,
  "description": "Dev-only tooling for the site. Nothing here ships (see deploy.mjs).",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "audit": "node audit.mjs",
    "html": "html-validate --config .htmlvalidate.json ../index.html ../404.html",
    "spell": "cspell --no-progress --config cspell.json ../index.html ../404.html \"../js/*.js\" ../.well-known/security.txt ../site.webmanifest",
    "lighthouse": "node lighthouse.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "cspell": "^10.3.4",
    "html-validate": "^11.16.0",
    "lighthouse": "^13.5.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
